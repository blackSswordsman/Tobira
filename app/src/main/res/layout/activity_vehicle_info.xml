<?xml version="1.0" encoding="utf-8"?>
<!-- The whole screen scrolls as one page, so dragging anywhere scrolls. / 画面全体を1ページとしてスクロール -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vehicle_info_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbarFadeDuration="0"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/vehicle_info_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/vehicle_info_title"
                android:textSize="24sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/vehicle_info_only_received"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/vehicle_info_only_received"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/vehicle_info_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/vehicle_info_live"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vehicle_info_flags"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vehicle_info_flags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="6"
            android:minLines="3"
            android:text="@string/vehicle_info_no_flags"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/vehicle_info_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/vehicle_info_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>

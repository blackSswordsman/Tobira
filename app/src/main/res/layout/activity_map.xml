<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/map_title"
            android:textSize="24sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/quest_preview_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/show_quest_panel"
            android:visibility="gone" />

        <Button
            android:id="@+id/route_points_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/route_points"
            android:visibility="gone" />

        <Button
            android:id="@+id/search_places_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/edit_route" />
    </LinearLayout>

    <TextView
        android:id="@+id/destination_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <Button
        android:id="@+id/build_route_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/build_route"
        android:visibility="gone" />

    <Button
        android:id="@+id/trip_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/start_trip"
        android:visibility="gone" />

    <TextView
        android:id="@+id/trip_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <TextView
        android:id="@+id/route_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <Button
        android:id="@+id/clear_destination_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/clear_destination"
        android:visibility="gone" />

    <TextView
        android:id="@+id/map_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/map_loading" />

    <Button
        android:id="@+id/retry_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:text="@string/retry"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <include layout="@layout/panel_quest" />

        <org.maplibre.android.maps.MapView
            android:id="@+id/map_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5" />
    </LinearLayout>

    <TextView
        android:id="@+id/map_attribution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center"
        android:text="@string/route_attribution" />

    <Button
        android:id="@+id/my_location_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:minHeight="64dp"
        android:enabled="false"
        android:text="@string/my_location" />
</LinearLayout>

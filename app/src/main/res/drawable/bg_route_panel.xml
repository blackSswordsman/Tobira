<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#20101010" />
            <stroke android:width="10dp" android:color="#18FFFFFF" />
        </shape>
    </item>
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#EE101010" />
            <stroke android:width="2dp" android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
